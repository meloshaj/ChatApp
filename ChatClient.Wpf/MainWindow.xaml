<Window x:Class="ChatClient.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Chat"
        Height="860"
        Width="1460"
        MinHeight="700"
        MinWidth="1120"
        Background="{StaticResource BackgroundBrush}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,16,16,12">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Messages"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="RefreshButton"
                                    Style="{StaticResource PlainIconButtonStyle}"
                                    ToolTip="Refresh"
                                    Margin="4,0,8,0"
                                    Click="RefreshButton_Click">
                                <Image Source="refreshICON.png"
                                       Stretch="Uniform"
                                       Width="32"
                                       Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <Button x:Name="LogoutButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Logout"
                                    Margin="4,0"
                                    Click="LogoutButton_Click">
                                <Path Data="M10 6H6a2 2 0 00-2 2v8a2 2 0 002 2h4M14 8l4 4-4 4M18 12H9"
                                      Stroke="{StaticResource ForegroundBrush}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource MutedBrush}"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,12"
                            x:Name="ConnectionPanel">
                        <StackPanel>
                            <TextBlock Text="Connection"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ForegroundBrush}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HostTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Height="36"
                                         Padding="12,8"
                                         Text="127.0.0.1" />
                                <TextBox x:Name="PortTextBox"
                                         Grid.Column="1"
                                         Margin="8,0,0,0"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Height="36"
                                         Padding="12,8"
                                         Text="13000" />
                            </Grid>
                            <TextBox x:Name="UsernameTextBox"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Height="36"
                                     Padding="12,8"
                                     Text="UserA" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ConnectButton"
                                        Grid.Column="0"
                                        Style="{StaticResource SendButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="ConnectButton_Click"
                                        Content="Connect" />
                                <Button x:Name="DisconnectButton"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Click="DisconnectButton_Click"
                                        Content="Disconnect" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <TextBox x:Name="SearchTextBox"
                                 Height="40"
                                 Padding="36,10,10,10"
                                 Background="{StaticResource MutedBrush}"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search"
                                   Margin="36,0,0,0"
                                   Foreground="{StaticResource MutedForegroundBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                        <Path Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                              Stroke="{StaticResource MutedForegroundBrush}"
                              StrokeThickness="2"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Width="16"
                              Height="16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>

                <ListBox x:Name="ContactsListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ContactsListBox_SelectionChanged"
                         MouseDoubleClick="ContactsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                Padding="16,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0">
                                    <Ellipse Fill="{StaticResource Avatar1Gradient}" />
                                    <TextBlock Text="{Binding Initials}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="14"
                                             Height="14"
                                             Fill="{Binding StatusBrush}"
                                             Stroke="{StaticResource CardBrush}"
                                             StrokeThickness="2"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,-2,-2" />
                                </Grid>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding LastMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="8,4"
                                        Background="{StaticResource MutedBrush}"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedForegroundBrush}" />
                                        <Border Background="{StaticResource PrimaryBlueBrush}"
                                                Padding="6,2"
                                                Margin="0,4,0,0"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadLabel}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40" Margin="0,0,12,0">
                                    <Ellipse Fill="{StaticResource Avatar2Gradient}" />
                                    <TextBlock x:Name="CurrentUserInitialsTextBlock"
                                               Text="ME"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentUserTextBlock"
                                               Text="Me"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource ForegroundBrush}" />
                                    <TextBlock x:Name="ConnectionStateTextBlock"
                                               Text="Disconnected"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedForegroundBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,6"
                                   Text="Friends and groups"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}" />
                        <Grid>
                            <TextBox x:Name="FriendUserTextBox"
                                     Height="36"
                                     Padding="12,8"
                                     Background="{StaticResource MutedBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     TextChanged="FriendUserTextBox_TextChanged" />
                            <TextBlock x:Name="FriendUserPlaceholder"
                                       Text="Friend username"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddFriendButton"
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Click="AddFriendButton_Click"
                                    Content="Add Friend" />
                            <Button x:Name="OpenPrivateChatButton"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Click="OpenPrivateChatButton_Click"
                                    Content="Open Chat" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <TextBox x:Name="GroupNameTextBox"
                                         Height="36"
                                         Padding="12,8"
                                         Background="{StaticResource MutedBrush}"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         BorderThickness="1"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="GroupNameTextBox_TextChanged" />
                                <TextBlock x:Name="GroupNamePlaceholder"
                                           Text="Group name"
                                           Margin="12,0,0,0"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="6,0,0,0">
                                <TextBox x:Name="GroupMemberTextBox"
                                         Height="36"
                                         Padding="12,8"
                                         Background="{StaticResource MutedBrush}"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         BorderThickness="1"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         TextChanged="GroupMemberTextBox_TextChanged" />
                                <TextBlock x:Name="GroupMemberPlaceholder"
                                           Text="Member username"
                                           Margin="12,0,0,0"
                                           Foreground="{StaticResource MutedForegroundBrush}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CreateGroupButton"
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Click="CreateGroupButton_Click"
                                    Content="Create" />
                            <Button x:Name="AddToGroupButton"
                                    Grid.Column="1"
                                    Margin="6,0,6,0"
                                    Click="AddToGroupButton_Click"
                                    Content="Add User" />
                            <Button x:Name="OpenGroupChatButton"
                                    Grid.Column="2"
                                    Margin="6,0,6,0"
                                    Click="OpenGroupChatButton_Click"
                                    Content="Open Group" />
                            <Button x:Name="RemoveFromGroupButton"
                                    Grid.Column="3"
                                    Margin="6,0,6,0"
                                    Click="RemoveFromGroupButton_Click"
                                    Content="Remove" />
                            <Button x:Name="RenameGroupButton"
                                    Grid.Column="4"
                                    Margin="6,0,0,0"
                                    Click="RenameGroupButton_Click"
                                    Content="Rename" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="40" Height="40" Margin="0,0,12,0">
                            <Ellipse Fill="{StaticResource Avatar1Gradient}" />
                            <TextBlock x:Name="ChatHeaderInitials"
                                       Text="NA"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ChatHeaderName"
                                       Text="No conversation selected"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{StaticResource ForegroundBrush}" />
                            <TextBlock x:Name="ChatHeaderStatus"
                                       Text="Connect, then choose a friend or group"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                            <TextBlock x:Name="ChatHeaderMembers"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource MutedBrush}"
                            Padding="12,8"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ClearChatButton"
                                    Content="Clear"
                                    Margin="0,0,10,0"
                                    Padding="10,4"
                                    Click="ClearChatButton_Click" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Disconnected."
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="1"
                          Padding="24,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MessagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Border Background="{Binding MessageBackground}"
                                        CornerRadius="{Binding CornerRadius}"
                                        Padding="16,12"
                                        MaxWidth="600"
                                        HorizontalAlignment="{Binding Alignment}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="2"
                                                          Opacity="0.1"
                                                          Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{Binding TimestampForeground}" />
                                        <TextBlock Text="{Binding Text}"
                                                   Margin="0,6,0,0"
                                                   Foreground="{Binding TextForeground}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasText}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding InlineImage}"
                                               Margin="0,8,0,0"
                                               MaxWidth="320"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OpenAudioButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Border Width="320"
                                                    Padding="14"
                                                    CornerRadius="14"
                                                    BorderThickness="1"
                                                    Background="#14000000"
                                                    BorderBrush="#33000000">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="56"
                                                          Height="56"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center">
                                                        <Ellipse Fill="#CC111827" />
                                                        <Path Data="M15 12l12 8-12 8V12z"
                                                              Fill="White"
                                                              Width="18"
                                                              Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AudioTitle}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TextForeground}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding AudioKindLabel}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{Binding TimestampForeground}" />
                                                        <TextBlock Text="Click to open"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{Binding TimestampForeground}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OpenVideoButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Border Width="320"
                                                    Padding="14"
                                                    CornerRadius="14"
                                                    BorderThickness="1"
                                                    Background="#14000000"
                                                    BorderBrush="#33000000">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="56"
                                                          Height="56"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center">
                                                        <Ellipse Fill="#CC111827" />
                                                        <Path Data="M15 12l12 8-12 8V12z"
                                                              Fill="White"
                                                              Width="18"
                                                              Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VideoTitle}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding TextForeground}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Video attachment"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{Binding TimestampForeground}" />
                                                        <TextBlock Text="Click to open"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{Binding TimestampForeground}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontSize="11"
                                                   Foreground="{Binding TimestampForeground}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathTextBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Height="36"
                                 Padding="12,8"
                                 Text=""
                                 Tag="Image path (use Browse button)" />
                        <TextBox x:Name="VoicePathTextBox"
                                 Grid.Column="1"
                                 Margin="8,0,8,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Height="36"
                                 Padding="12,8"
                                 Text=""
                                 Tag="Voice path (use Browse button)" />
                        <TextBox x:Name="VideoPathTextBox"
                                 Grid.Column="2"
                                 Margin="8,0,8,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Height="36"
                                 Padding="12,8"
                                 Text=""
                                 Tag="Video path (use Browse button)" />
                        <TextBox x:Name="VoiceDurationTextBox"
                                 Grid.Column="3"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Height="36"
                                 Padding="12,8"
                                 Text="0" />
                    </Grid>

                    <TextBlock x:Name="AttachmentPreviewTextBlock"
                               Margin="0,0,0,8"
                               FontSize="12"
                               Foreground="{StaticResource MutedForegroundBrush}"
                               Visibility="Collapsed" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EmojiButton"
                                Grid.Column="0"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40"
                                Height="40"
                                ToolTip="Add emoji"
                                Margin="0,0,12,0"
                                Click="EmojiButton_Click">
                            <TextBlock Text="☺"
                                       FontSize="20"
                                       Foreground="{StaticResource MutedForegroundBrush}" />
                        </Button>
                        <Popup x:Name="EmojiPopup"
                               PlacementTarget="{Binding ElementName=EmojiButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,0,8">
                                <WrapPanel Width="220">
                                    <Button Content="😀" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="😂" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="😍" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="😎" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="👍" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="🙏" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="🔥" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="🎉" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="❤️" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                    <Button Content="✅" FontSize="18" Width="36" Height="32" Click="EmojiPickerButton_Click" />
                                </WrapPanel>
                            </Border>
                        </Popup>
                        <Button x:Name="BrowseImageButton"
                                Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40"
                                Height="40"
                                ToolTip="Choose image"
                                Margin="0,0,8,0"
                                Click="BrowseImageButton_Click">
                            <Path Data="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                  Stroke="{StaticResource MutedForegroundBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Button>
                        <Button x:Name="BrowseVoiceButton"
                                Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40"
                                Height="40"
                                ToolTip="Choose audio"
                                Margin="0,0,8,0"
                                Click="BrowseVoiceButton_Click">
                            <Path Data="M9 18V5l12-2v13M9 9l12-2M6 18a3 3 0 106 0 3 3 0 00-6 0zm12-2a3 3 0 106 0 3 3 0 00-6 0z"
                                  Stroke="{StaticResource MutedForegroundBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Button>
                        <Button x:Name="BrowseVideoButton"
                                Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40"
                                Height="40"
                                ToolTip="Choose video"
                                Margin="0,0,12,0"
                                Click="BrowseVideoButton_Click">
                            <Path Data="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                                  Stroke="{StaticResource MutedForegroundBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Button>
                        <Grid Grid.Column="4" Margin="0,0,12,0">
                            <TextBox x:Name="MessageInputTextBox"
                                     Height="48"
                                     Padding="16,12"
                                     FontSize="16"
                                     Background="{StaticResource MutedBrush}"
                                     Foreground="{StaticResource ForegroundBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     KeyDown="MessageInputTextBox_KeyDown"
                                     TextChanged="MessageInputTextBox_TextChanged"
                                     Text="" />
                            <TextBlock x:Name="MessageInputPlaceholder"
                                       Text="Type your message here..."
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource MutedForegroundBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Button x:Name="SendImageButton"
                                Grid.Column="5"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40"
                                Height="40"
                                ToolTip="Send selected attachment"
                                Margin="0,0,12,0"
                                Click="SendImageButton_Click">
                            <Path Data="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"
                                  Stroke="{StaticResource MutedForegroundBrush}"
                                  StrokeThickness="2"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="20"
                                  Height="20" />
                        </Button>
                        <Button x:Name="SendButton"
                                Grid.Column="6"
                                Style="{StaticResource SendButtonStyle}"
                                Click="SendButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 19l9-7-9-7v4.586C4 10.586 4 19 4 19s0-6 8-6.414V19z"
                                      Fill="White"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
